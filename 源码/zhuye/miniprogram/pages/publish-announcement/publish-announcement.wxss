.page {
  background-color: #f6f1ea;
  min-height: 100vh;
}
.one{
    margin-top: 110rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 60rpx;
  background-color: #fff;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-left, .header-right {
  width: 80rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #1989fa;
  font-weight: bold;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.submit-btn {
  font-size: 28rpx;
  color: #1989fa;
  font-weight: bold;
}

.content {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #fff;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
}

.form-input:focus {
  border-color: #1989fa;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
  resize: none;
}

.form-textarea:focus {
  border-color: #1989fa;
}

.form-time {
  display: block;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #fff;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e8e8;
  color: #666;
}

/* 照片上传样式 */
.upload-area {
  width: 100%;
  height: 200rpx;
  background-color: #fff;
  border-radius: 8rpx;
  border: 2rpx dashed #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.upload-icon {
  font-size: 60rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 底部提交按钮样式 */
.submit-section {
  margin-top: 60rpx;
  padding: 0 30rpx;
}

.submit-section .submit-btn {
  width: 100%;
  height: 88rpx;
  background-color: #1989fa;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(25, 137, 250, 0.3);
  letter-spacing: 2rpx;
}

.submit-section .submit-btn::after {
  border: none;
}