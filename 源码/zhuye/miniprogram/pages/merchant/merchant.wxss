/* 预约信息样式 - 优化版本 */
.reserve-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #f0f9ff, #e6f7ff);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #1890ff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.reserve-info::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1), rgba(14, 165, 233, 0.1));
  border-radius: 50%;
  z-index: 0;
}

.reserve-time {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  position: relative;
  padding-left: 48rpx;
  z-index: 1;
}

.reserve-time::before {
  content: '⏰';
  position: absolute;
  left: 0;
  top: 0;
  font-size: 32rpx;
  color: #1890ff;
  vertical-align: middle;
}

.party-size {
  display: block;
  font-size: 32rpx;
  color: #1890ff;
  font-weight: 600;
  position: relative;
  padding-left: 48rpx;
  z-index: 1;
}

.party-size::before {
  content: '👥';
  position: absolute;
  left: 0;
  top: 0;
  font-size: 32rpx;
  color: #1890ff;
  vertical-align: middle;
}

/* 订单操作按钮样式 - 优化版本 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 4rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.order-actions button {
  font-size: 28rpx;
  border-radius: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx;
  transition: all 0.3s ease;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.order-actions button[type="primary"] {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  color: #ffffff;
  border: none;
}

.order-actions button[type="primary"]:active {
  background: linear-gradient(135deg, #096dd9, #1890ff);
  transform: translateY(2rpx);
}

.order-actions button[type="warn"] {
  background: linear-gradient(135deg, #ffffff, #f5f5f5);
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}

.order-actions button[type="warn"]:active {
  background: linear-gradient(135deg, #fff1f0, #ffffff);
  transform: translateY(2rpx);
}

/* 空状态样式 - 优化版本 */
.empty-state {
