/* pages/merchant/merchant.wxss */
page {
  background: #f6f1ea;
}

.page {
  background: #f6f1ea;
  min-height: 100vh;
}

/* 预约控制按钮样式 - 优化版本 */
.order-controls {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
  padding: 0 30rpx;
  gap: 16rpx;
}

.order-controls .control-btn {
  width: 48%;
  font-size: 32rpx;
  padding: 24rpx 0;
  line-height: 1.2;
  margin: 0;
  border-radius: 12rpx;
  font-weight: 600;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.order-controls .control-btn.primary {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  color: #fff;
  border: none;
}

.order-controls .control-btn.primary:active {
  background: linear-gradient(135deg, #096dd9, #1890ff);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.order-controls .control-btn.warn {
  background: linear-gradient(135deg, #ff6666, #ff5252);
  color: #fff;
  border: none;
}

.order-controls .control-btn.warn:active {
  background: linear-gradient(135deg, #e55555, #e54646);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

/* 订单列表样式 - 优化版本 */
.order-list {
  padding: 0 20rpx;
}

/* 订单项卡片样式 - 优化版本 */
.order-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.order-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #1890ff, #40a9ff);
}

.order-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 订单头部样式 - 优化版本 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

/* 订单状态样式 - 优化版本 */
.order-status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.order-status.reserved {
  background: linear-gradient(135deg, #f6ffed, #e6f7ff);
  color: #07c160;
  border: 1rpx solid #b7eb8f;
}

.order-status.completed {
  background: linear-gradient(135deg, #f0f0f0, #fafafa);
  color: #666;
  border: 1rpx solid #d9d9d9;
}

.order-status.expired {
  background: linear-gradient(135deg, #fff1f0, #fff2f0);
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

/* 订单信息样式 - 优化版本 */
.order-info {
  margin-bottom: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.customer {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #f0f9ff, #e6f7ff);
  border-radius: 20rpx;
  inline-size: fit-content;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

