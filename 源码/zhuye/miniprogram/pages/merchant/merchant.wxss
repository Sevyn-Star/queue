/* 表单 */
/* 表单容器样式 */
.form-container {
    padding: 16px; /* 给整体表单加内边距，避免边缘内容被遮挡 */
    overflow: visible; /* 确保表单内元素不被容器裁剪 */
  }
  
  /* 表单项样式 */
  .form-item {
    margin-bottom: 16px;
    position: relative; /* 避免子元素定位偏移 */
    overflow: visible; /* 关键：防止内容溢出被隐藏 */
  }
  
  /* 标签样式 */
  .label {
    display: block;
    font-size: 14px;
    color: #333;
    margin-bottom: 8px;
    line-height: 1.5; /* 确保标签文字不重叠 */
  }
  
  /* 输入框和文本域基础样式 */
  .form-item input,
  .form-item textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    font-size: 14px;
    box-sizing: border-box; /* 确保padding和border不撑开宽度 */
    line-height: 1.5; /* 关键：让文字垂直居中，不贴底 */
    min-height: 44px; /* 确保输入框有足够高度容纳文字 */
    background-color: #fff; /* 明确背景色，避免与页面背景融合 */
  }
  
  /* 文本域样式优化 */
  .form-item textarea {
    height: auto; /* 取消固定高度，改为自适应内容 */
    min-height: 100px; /* 最小高度，确保初始显示足够空间 */
    resize: none; /* 禁止手动调整大小 */
    padding-top: 14px; /* 顶部内边距稍大，文字更居中 */
    padding-bottom: 14px;
  }
  
  /* 聚焦状态优化（可选，提升体验） */
  .form-item input:focus,
  .form-item textarea:focus {
    border-color: #1677ff; /* 聚焦时边框变色，明确当前输入状态 */
    outline: none; /* 去除默认轮廓 */
  }
  
  /* 占位符样式（可选，增强可读性） */
  .form-item input::placeholder,
  .form-item textarea::placeholder {
    color: #999; /* 占位符颜色稍浅，与输入文字区分 */
    font-size: 14px;
  }

