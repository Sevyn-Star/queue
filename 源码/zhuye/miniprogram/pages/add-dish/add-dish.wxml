<!-- pages/add-dish/add-dish.wxml -->
<view class="page">
  <!-- <view class="header">
    <text class="title">添加菜品</text>
  </view> -->
  
  <view class="content">
    <!-- 图片上传区域 -->
    <view class="form-section">
      <text class="section-title">菜品图片</text>
      <view class="image-upload">
        <view class="image-preview" wx:if="{{image}}">
          <image src="{{image}}" mode="aspectFill"></image>
        </view>
        <view class="upload-btn" wx:else bindtap="onChooseImage">
          <text class="upload-icon">+</text>
          <text class="upload-text">点击上传</text>
        </view>
      </view>
    </view>
    
    <!-- 菜品信息表单 -->
    <view class="form-section">
      <text class="section-title">菜品信息</text>
      
      <view class="form-item">
        <text class="label">菜品名称 <text class="required">*</text></text>
        <input value="{{dishName}}" bindinput="onNameInput" placeholder="请输入菜品名称" />
      </view>
      
      <view class="form-item">
        <text class="label">菜品描述</text>
        <textarea value="{{description}}" bindinput="onDescriptionInput" placeholder="请输入菜品描述" />
      </view>
      
      <view class="form-item">
        <text class="label">菜品价格 <text class="required">*</text></text>
        <input type="digit" value="{{price}}" bindinput="onPriceInput" placeholder="请输入菜品价格" />
      </view>
      
      <!-- <view class="form-item">
        <text class="label">菜品分类</text>
        <picker bindchange="onCategoryChange" value="{{categories.indexOf(selectedCategory)}}" range="{{categories}}">
          <view class="picker">
            {{selectedCategory}}
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view> -->
      
      <view class="form-item">
        <text class="label">初始库存</text>
        <input type="number" value="{{quantity}}" bindinput="onQuantityInput" placeholder="请输入初始库存" />
      </view>
    </view>
    
    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn"  bindtap="onSubmit">确认添加</button>
    </view>
  </view>
</view>