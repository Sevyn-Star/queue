.pending-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx 48rpx;
  box-sizing: border-box;
  background: #f6f1ea;
}
.pending-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}
.pending-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #2b2118;
}
.pending-desc {
  font-size: 28rpx;
  color: #8a7d72;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 24rpx;
}
.pending-meta {
  font-size: 26rpx;
  color: #8a7d72;
  margin-top: 8rpx;
}
.pending-actions {
  margin-top: 60rpx;
  width: 100%;
}
.pending-btn {
  width: 80%;
  margin: 16rpx auto;
  border-radius: 999rpx;
  font-size: 28rpx;
  background: #fff;
  color: #2b2118;
  box-shadow: 0 8rpx 24rpx rgba(43, 33, 24, 0.06);
}
.pending-btn.primary {
  background: linear-gradient(135deg, #ff7a45, #ff6b35);
  color: #fff;
}
.pending-btn::after {
  border: none;
}
