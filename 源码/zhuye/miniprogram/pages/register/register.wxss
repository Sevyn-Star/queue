/* pages/register/register.wxss */
page {
  background-color: #f6f1ea;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.register-container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.register-header {
  text-align: center;
  margin-bottom: 50rpx;
}

.register-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.register-subtitle {
  font-size: 28rpx;
  color: #666;
}

.register-form {
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 1px solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #ff6b35;
  outline: none;
}

/* 文本域样式 */
.form-textarea {
  width: 100%;
  height: 180rpx;
  border: 1px solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  resize: none;
  font-family: inherit;
}

.form-textarea:focus {
  border-color: #ff6b35;
  outline: none;
}

/* 店铺头像上传样式 */
.shop-avatar-upload {
  display: flex;
  justify-content: center;
}

.shop-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f5f5f5;
  border: 2px dashed #e0e0e0;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-avatar-btn::after {
  border: none;
}

.shop-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.shop-avatar-placeholder {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 20rpx;
}

/* 头像上传样式 */
.avatar-upload {
  display: flex;
  justify-content: center;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #f5f5f5;
  border: 2px dashed #e0e0e0;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 20rpx;
}

/* 营业执照上传样式 */
.license-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.license-btn {
  width: 100%;
  height: 200rpx;
  background-color: #f5f5f5;
  border: 2px dashed #e0e0e0;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.license-btn::after {
  border: none;
}

.license-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.license-placeholder {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  padding: 20rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 提交按钮样式 */
.submit-btn {
  width: 100%;
  height: 90rpx;
  background-color: #ff6b35;
  color: white;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 30rpx;
  line-height: 90rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background-color: #e85a28;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 500rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.modal-message {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 30rpx;
  display: block;
  line-height: 44rpx;
}

.modal-btn {
  background-color: #ff6b35;
  color: white;
  font-size: 32rpx;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.modal-btn::after {
  border: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .register-container {
    padding: 30rpx 20rpx;
  }
  
  .register-form {
    padding: 30rpx;
  }
  
  .avatar-btn {
    width: 140rpx;
    height: 140rpx;
  }
  
  .license-btn {
    height: 180rpx;
  }
}